.container {
  padding: 30rpx;
  background-color: #f8f9fa;
  min-height: 100vh;
}

.header {
  margin-bottom: 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
}

.section {
  margin-bottom: 40rpx;
  background: white;
  padding: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #333;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.tag {
  padding: 12rpx 30rpx;
  background: #f0f0f0;
  border-radius: 100rpx;
  font-size: 28rpx;
  color: #666;
  border: 1px solid transparent;
}

.tag.active {
  background: #ede9fe;
  color: #7c3aed;
  border-color: #7c3aed;
}

.custom-input {
  margin-top: 20rpx;
  background: #f9f9f9;
  padding: 20rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.btn-primary {
  background: #7c3aed;
  color: white;
  border-radius: 100rpx;
  margin-top: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(124, 58, 237, 0.3);
}

.results {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.result-card {
  background: white;
  padding: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #7c3aed;
}

.badges {
  display: flex;
  gap: 10rpx;
}

.badge {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.badge-yellow {
  background: #fffbeb;
  color: #d97706;
}

.badge-green {
  background: #f0fdf4;
  color: #16a34a;
}

.card-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.btn-outline {
  width: 100% !important;
  border: 1px solid #e5e7eb !important;
  color: #333 !important;
  font-weight: normal !important;
}

.btn-text {
  margin-top: 30rpx;
  background: transparent;
  color: #666;
}
