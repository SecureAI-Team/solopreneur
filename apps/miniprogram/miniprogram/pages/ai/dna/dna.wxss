.container {
  padding: 30rpx;
  background-color: #f8f9fa;
  min-height: 100vh;
}

.header {
  margin-bottom: 60rpx;
  text-align: center;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
}

.section {
  background: white;
  padding: 40rpx;
  border-radius: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.input-lg {
  height: 100rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 0 30rpx;
  font-size: 32rpx;
  margin-bottom: 40rpx;
}

.btn-primary {
  background: #7c3aed;
  color: white;
  border-radius: 100rpx;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 32rpx;
}

.result-container {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.dna-card {
  padding: 30rpx;
  border-radius: 20rpx;
  border: 1px solid rgba(0,0,0,0.05);
}

.dna-card.violet {
  background: #f5f3ff;
  border-color: #ddd6fe;
}
.dna-card.blue {
  background: #eff6ff;
  border-color: #dbeafe;
}
.dna-card.pink {
  background: #fdf2f8;
  border-color: #fce7f3;
}

.card-label {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
  opacity: 0.8;
}

.card-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.bio-card {
  background: #1f2937;
  color: white;
  padding: 40rpx;
  border-radius: 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.2);
}

.bio-label {
  font-size: 24rpx;
  color: #9ca3af;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
}

.bio-text {
  font-size: 34rpx;
  line-height: 1.6;
  font-weight: 500;
}

.btn-outline {
  width: 100% !important;
  background: white;
  border: 1px solid #e5e7eb;
}
