/* pages/content/index.wxss */
.container {
  padding: 0;
  background-color: #f7f8fa;
  min-height: 100vh;
}

.header {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
}

.search-bar {
  flex: 1;
  background: #f0f1f3;
  border-radius: 32rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

.search-bar icon {
  margin-right: 12rpx;
}

.search-bar input {
  flex: 1;
  font-size: 28rpx;
}

.view-toggle {
  margin-left: 20rpx;
  padding: 10rpx;
}

.view-toggle .icon {
  font-size: 40rpx;
  color: #333;
}

.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #7c3aed;
  font-weight: 500;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #7c3aed;
  border-radius: 2rpx;
}

.content-list {
  padding: 24rpx;
}

/* List View */
.content-list.list .content-item {
  display: flex;
  background: #fff;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.content-list.list .cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  background: #eee;
}

.content-list.list .info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.content-list.list .title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Grid View */
.content-list.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.content-list.grid .content-item {
  width: 48%; /* 2 cols */
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.content-list.grid .cover {
  width: 100%;
  height: 300rpx;
  background: #eee;
}

.content-list.grid .info {
  padding: 20rpx;
}

.content-list.grid .title {
  font-size: 28rpx;
  line-height: 1.4;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
}

.status.tag {
  background: #f0f1f3;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}

.status.published {
    background: #e6fffb;
    color: #13c2c2;
}

.status.draft {
    background: #f5f5f5;
    color: #999;
}

.platforms {
    display: flex;
    margin-right: 12rpx;
}

.platform-icon {
    width: 32rpx;
    height: 32rpx;
    font-size: 20rpx;
    color: #fff;
    background: #ccc;
    border-radius: 50%;
    text-align: center;
    line-height: 32rpx;
    margin-right: 6rpx;
}

.platform-icon.wechat { background: #07c160; }
.platform-icon.douyin { background: #000; }
.platform-icon.xiaohongshu { background: #ff2442; }
.platform-icon.bilibili { background: #00aeec; }

.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}
