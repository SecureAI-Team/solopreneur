/* pages/publish/index.wxss */
.container {
  padding-bottom: 120rpx; /* Space for footer */
  background: #fff;
  min-height: 100vh;
}

.section {
  padding: 30rpx;
}

/* Media Uploader */
.media-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.media-item {
  width: 220rpx;
  height: 220rpx;
  position: relative;
  border-radius: 12rpx;
  overflow: hidden;
}

.media-preview {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 36rpx;
  font-size: 32rpx;
}

.add-btn {
  width: 220rpx;
  height: 220rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
}

.add-btn .plus {
  font-size: 60rpx;
  font-weight: 300;
  margin-bottom: 10rpx;
}

.add-btn .tip {
  font-size: 24rpx;
}

/* Inputs */
.input-section {
  padding-top: 0;
}

.input-group {
    display: flex;
    align-items: center;
}

.input-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: 500;
  height: 80rpx;
}

.ai-btn {
    font-size: 24rpx;
    color: #7c3aed;
    background: #f3e8ff;
    padding: 8rpx 20rpx;
    border-radius: 20rpx;
    display: flex;
    align-items: center;
}

.divider {
  height: 1rpx;
  background: #eee;
  margin: 20rpx 0;
}

.input-body {
  width: 100%;
  min-height: 200rpx;
  font-size: 30rpx;
  line-height: 1.6;
}

.placeholder {
  color: #ccc;
}

/* Platforms */
.platform-section {
  border-top: 20rpx solid #f7f8fa;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
}

.platform-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.platform-item:last-child {
  border-bottom: none;
}

.platform-item text {
  margin-left: 20rpx;
  font-size: 30rpx;
}

/* Footer */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 20rpx 30rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding-bottom: env(safe-area-inset-bottom);
}

.submit-btn {
  background: #7c3aed;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.submit-btn[disabled] {
  background: #ccc;
  color: #fff;
}
