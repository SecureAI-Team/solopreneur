<!--pages/profile/index.wxml-->
<view class="container">
  <!-- User Header -->
  <view class="header">
    <block wx:if="{{userInfo}}">
        <image class="avatar" src="{{userInfo.avatar || 'https://api.dicebear.com/7.x/avataaars/svg?seed=Felix'}}" mode="aspectFill"></image>
        <view class="info">
            <text class="nickname">{{userInfo.nickname}}</text>
            <text class="plan tag">{{userInfo.plan === 'pro' ? '专业版' : '免费版'}}</text>
        </view>
    </block>
    <block wx:else>
        <view class="avatar placeholder"></view>
        <view class="info" bindtap="handleLogin">
            <text class="nickname">点击登录</text>
            <text class="desc">登录后体验更多功能</text>
        </view>
    </block>
  </view>

  <!-- Menu List -->
  <view class="menu-list">
    <navigator url="/pages/settings/index" class="menu-item">
        <text class="label">⚙️ 设置</text>
        <text class="arrow">></text>
    </navigator>
    <view class="menu-item">
        <text class="label">❓ 帮助与反馈</text>
        <text class="arrow">></text>
    </view>
    <view class="menu-item">
        <text class="label">ℹ️ 关于我们</text>
        <text class="arrow">></text>
    </view>
  </view>
  
  <view class="logout-btn" wx:if="{{userInfo}}" bindtap="handleLogout">
    退出登录
  </view>
</view>