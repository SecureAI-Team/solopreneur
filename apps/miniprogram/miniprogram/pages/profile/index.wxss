/* pages/profile/index.wxss */
.container {
  padding: 30rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
}

.header {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 40rpx;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 30rpx;
  background: #eee;
}

.avatar.placeholder {
  background: #ccc;
}

.info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.desc {
    font-size: 26rpx;
    color: #999;
}

.plan.tag {
    align-self: flex-start;
    font-size: 22rpx;
    background: #000;
    color: #ffd700;
    padding: 4rpx 12rpx;
    border-radius: 8rpx;
}

.menu-list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 40rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 30rpx;
  color: #333;
}

.menu-item:last-child {
  border-bottom: none;
}

.arrow {
  color: #ccc;
}

.logout-btn {
    text-align: center;
    background: #fff;
    color: #ff4d4f;
    padding: 30rpx;
    border-radius: 20rpx;
    font-size: 30rpx;
}
