
# ------------------------------------------------------------------
# SoloMedia Production Environment Variables
# Copy this file to .env.production and fill in the values
# ------------------------------------------------------------------

# Node Environment
NODE_ENV=production
PORT=3001

# Postgres Database (Internal Docker Network)
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=solopreneur
DATABASE_URL=postgresql://postgres:your_secure_db_password@db:5432/solopreneur

# Redis (Internal Docker Network)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Auth
JWT_SECRET=generate_a_long_secure_random_string_here

# Aliyun AI Service (Qwen)
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# WeChat Platform
WX_APPID=your_wechat_appid
WX_SECRET=your_wechat_secret
WX_TOKEN=your_wechat_token_for_verification

# Domain Configuration
DOMAIN=https://your-domain.com

# Object Storage (Aliyun OSS - Optional for Alpha)
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=oss-cn-hangzhou
